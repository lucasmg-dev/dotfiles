{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "LucasG",
  "permission": {
    "skill": {
      "bolavip-platform": "allow",
      "*": "deny"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "enabled": true
    }
  }
}
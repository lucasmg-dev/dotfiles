# ── Ignorar todo por defecto, incluir solo lo explícito ──
*

# ── Dotfiles que sí queremos versionar ──
!.gitignore
!CLAUDE.md
!AGENTS.md
!README.md

# Fish
!fish/
!fish/**
# Secretos de Fish — NUNCA versionar (last-match gana sobre !fish/**)
fish/conf.d/secrets.fish
fish/fish_variables

# Ghostty
!ghostty/
!ghostty/**

# Neovim
!nvim/
!nvim/**
nvim/lazy-lock.json

# Starship
!starship.toml

# AI tools (source of truth)
!ai/
!ai/**
ai/**/node_modules/

# tmux
!.tmux.conf
!tmux/
!tmux/**



# iTerm2
!iterm2/
!iterm2/**
iterm2/AppSupport
iterm2/AppSupport/**
**/.DS_Store

# Gemini
!gemini/
!gemini/**
# Estado de runtime de Antigravity — historial/sesiones privadas, NUNCA versionar
gemini/antigravity/

# AI shared skills/commands
!ai/
!ai/**

# Install script
!install.sh
